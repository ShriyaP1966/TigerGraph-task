// ============================================================================
// Derived fraud-ring backbone: SHARES_DEVICE, SHARES_EMAIL, SHARES_ADDRESS
// between Card vertices. This is the self-join P1 owns per the plan --
// the foundation for find_fraud_ring / WCC clustering.
//
// IMPORTANT — combinatorial-blowup guard: this dataset only has 60 distinct
// email domains and 332 billing regions across 13,553 customers. A naive
// self-join on "same email domain" or "same billing region" would connect
// nearly every card to every other card through generic providers
// (gmail.com, yahoo.com, ...) and common regions, producing a dense,
// meaningless graph. DeviceProfile (9,705 distinct profiles) does not have
// this problem -- device fingerprints are naturally high-cardinality, so
// SHARES_DEVICE is built without a threshold.
//
// SHARES_EMAIL and SHARES_ADDRESS therefore take a max_cards parameter:
// only build the edge for a shared domain/region if the number of distinct
// cards touching it is AT OR BELOW that threshold. A domain/region touched
// by hundreds of cards is not a ring signal, it's just a popular provider
// or a populous region -- exactly the caution the dataset README gives
// ("Devices and regions connect people... some cases can only be solved by
// asking what happened on other cards", implying a *narrow*, specific
// shared element, not a broad one).
//
// Run once after loading (and re-run if data changes):
//   gsql -g FraudGraph "RUN QUERY build_shares_device()"
//   gsql -g FraudGraph "RUN QUERY build_shares_email(30)"
//   gsql -g FraudGraph "RUN QUERY build_shares_address(60)"
// ============================================================================

// Query bodies below were exported verbatim from the live TigerGraph Cloud
// instance (graph FraudGraph) on 2026-09-24, where P1 fixed them directly
// (all status VALID, not yet installed). Comments are from the repo version.
// UNREVIEWED DIVERGENCE: the live build_shares_email/address take no max_cards
// parameter, so the blowup guard described above is gone and the RUN examples
// with (30)/(60) will not match. Pairs use c1 != c2 (both directions), not <.

USE GRAPH FraudGraph

CREATE OR REPLACE QUERY build_shares_device() FOR GRAPH FraudGraph SYNTAX v2 {
  X = SELECT c2
      FROM Card:c1 -(MADE>)- Transaction:t1
                  -(FROM_DEVICE>)- DeviceProfile:d
                  -(<FROM_DEVICE)- Transaction:t2
                  -(<MADE)- Card:c2
      WHERE c1 != c2
      ACCUM INSERT INTO SHARES_DEVICE VALUES (c1, c2, d.device_id);
      
  PRINT X;
}

CREATE OR REPLACE QUERY build_shares_email() FOR GRAPH FraudGraph SYNTAX v2 {
  X = SELECT c2
      FROM Card:c1 -(MADE>)- Transaction:t1
                  -(PURCHASER_EMAIL>)- EmailDomain:d
                  -(<PURCHASER_EMAIL)- Transaction:t2
                  -(<MADE)- Card:c2
      WHERE c1 != c2
      ACCUM INSERT INTO SHARES_EMAIL VALUES (c1, c2, d.domain);
      
  PRINT X;
}

CREATE OR REPLACE QUERY build_shares_address() FOR GRAPH FraudGraph SYNTAX v2 {
  X = SELECT c2
      FROM Card:c1 -(MADE>)- Transaction:t1
                  -(BILLED_IN>)- BillingRegion:r
                  -(<BILLED_IN)- Transaction:t2
                  -(<MADE)- Card:c2
      WHERE c1 != c2
      ACCUM INSERT INTO SHARES_ADDRESS VALUES (c1, c2, r.region_code);
      
  PRINT X;
}

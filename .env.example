# graph backend: mock | local | tigergraph
GRAPH_BACKEND=local

# llm: fixture (no api calls, for dev) | live (groq primary, gemini fallback)
LLM_MODE=fixture
GROQ_API_KEY=
GEMINI_API_KEY=

# where transactions.csv / identity.csv live
DATA_DIR=data

# cap rows read from transactions.csv for fast dev runs, empty = read all
SAMPLE_ROWS=

# tigergraph backend (only used when GRAPH_BACKEND=tigergraph)
TG_HOST=
TG_GRAPH_NAME=
TG_USERNAME=
TG_PASSWORD=
TG_MCP_URL=
